# Copiar este archivo como .env y personalizar los valores
PORT=3000
NODE_ENV=development

# Crea este archivo JSON desde Firebase Console > Configuración del proyecto > Cuentas de servicio.
# Debe quedar en la raíz del proyecto. NUNCA lo subas a GitHub.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Contraseña para entrar al panel municipal (cámbiala).
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Secreto de sesión, debe ser aleatorio de 32 caracteres o más.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=PEGA_AQUI_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
